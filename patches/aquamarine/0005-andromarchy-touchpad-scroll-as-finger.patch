diff --git i/src/backend/Andromarchy.cpp w/src/backend/Andromarchy.cpp
index aafad45..e32a2af 100644
--- i/src/backend/Andromarchy.cpp
+++ w/src/backend/Andromarchy.cpp
@@ -434,9 +434,14 @@ void Aquamarine::CAndromarchyBackend::processInput(const InputEvent& ev) {
         case INPUT_TYPE_POINTER_AXIS:
             if (pointer) {
                 // protocol axis: 0 = vertical, 1 = horizontal (wayland order, same as aquamarine)
+                // source: a touchpad's two-finger scroll comes as "finger", like libinput's. As a wheel, the
+                // compositor counted every pixel of it as 1/15 of a wheel click (scrolling raced), its touchpad
+                // scroll factor did not apply, and apps got no end of scroll (no kinetic scrolling). A finger scroll
+                // ends with a 0 delta, which the compositor turns into axis_stop.
                 pointer->events.axis.emit(IPointer::SAxisEvent{.timeMs   = t,
                                                                .axis     = ev.pointer_axis.axis == 0 ? IPointer::AQ_POINTER_AXIS_VERTICAL : IPointer::AQ_POINTER_AXIS_HORIZONTAL,
-                                                               .source   = IPointer::AQ_POINTER_AXIS_SOURCE_WHEEL,
+                                                               .source   = ev.pointer_axis.source == POINTER_AXIS_SOURCE_FINGER ? IPointer::AQ_POINTER_AXIS_SOURCE_FINGER :
+                                                                                                                                  IPointer::AQ_POINTER_AXIS_SOURCE_WHEEL,
                                                                .delta    = ev.pointer_axis.value,
                                                                .discrete = (double)ev.pointer_axis.discrete});
                 pointer->events.frame.emit();
